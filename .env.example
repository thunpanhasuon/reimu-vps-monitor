# Copy to .env and enter your token. Run setup to pair your Telegram chat.
TELEGRAM_BOT_TOKEN=paste_your_bot_token_here
TELEGRAM_CHAT_ID=
SERVER_NAME=ubuntu-flandre
CHECK_INTERVAL_SECONDS=15
SUSTAINED_SECONDS=120
REMINDER_SECONDS=1800
CPU_THRESHOLD=90
RAM_THRESHOLD=90
DISK_THRESHOLD=85
DISK_PATH=/
NETWORK_INTERFACE=auto
# Incoming and outgoing Mbps checked separately. 0 disables traffic alerts.
NETWORK_MBPS=100

# These maintenance switches control reports only. To separately enable
# security-only installation, use install --enable-security-updates.
# No setting here grants the monitor administrative privileges.
UPDATE_ALERTS=true
CVE_ALERTS=true
REIMU_UPDATE_ALERTS=true
PORT_ALERTS=true
MAINTENANCE_INTERVAL_SECONDS=21600
CVE_INTERVAL_SECONDS=86400
PORT_INTERVAL_SECONDS=60
# Suppress new-listener alerts for these expected ports. Binding expansions
# from localhost still alert. Stopped listeners are always reported.
EXPECTED_PORTS=tcp:22
# Leave empty for local use; installer selects /var/lib/reimu-vps.
STATE_DIRECTORY=
# Optional manually supplied device-key expiry date (YYYY-MM-DD).
# Dates are checked in Asia/Phnom_Penh; no Tailscale key or API token is needed.
TAILSCALE_KEY_EXPIRY=
